# Local app URL used for redirects and same-origin checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional comma-separated additional full origins approved for auth redirects.
# Vercel's current deployment and branch URLs are approved automatically.
POKE_NOTES_AUTH_REDIRECT_ORIGINS=

# Supabase project used by the running app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key for admin/server-side Supabase actions.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project used by migration and seed scripts.
NEW_SUPABASE_URL=
NEW_SUPABASE_SERVICE_KEY=

# Secret used by the scheduled catalog sync endpoint.
CRON_SECRET=

# Dedicated secret for the hourly Limitless events sync.
LIMITLESS_SYNC_SECRET=

# Optional Pokemon TCG API key used by the card-effect catalog sync.
POKEMON_TCG_API_KEY=

# Optional legacy source project, only needed for migrate.mjs.
OLD_SUPABASE_URL=
OLD_SUPABASE_SERVICE_KEY=

# Optional local debugging flags.
POKE_NOTES_DEBUG_AUTH=
POKE_NOTES_DEBUG_PERF=

# Optional local-development login. These values are ignored by production routes.
POKE_NOTES_ENABLE_TEST_LOGIN=
POKE_NOTES_TEST_LOGIN_EMAIL=
POKE_NOTES_TEST_LOGIN_PASSWORD=
POKE_NOTES_LOCAL_LOGIN_CODE=
# Exact comma-separated hosts allowed to show and submit local login.
# Example: localhost:3000,127.0.0.1:3000,My-Mac.local:3000,192.168.1.10:3000
POKE_NOTES_LOCAL_LOGIN_HOSTS=
