{
  "name": "poke-notes",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "audit:deck-compatibility": "node scripts/audit-deck-compatibility.mjs",
    "audit:pokemon-catalog": "tsx audit-pokemon-catalog.ts",
    "audit:pokemon-options": "node audit-pokemon-options.mjs",
    "backfill:deck-list-visual-sort": "tsx backfill-deck-list-visual-sort.ts",
    "backfill:log-links": "tsx backfill-log-links.ts",
    "clean": "rm -rf .next .next-e2e",
    "dev": "next dev --port 3000",
    "dev:perf": "POKE_NOTES_DEBUG_PERF=1 next dev --port 3000",
    "dev:reset": "rm -rf .next && next dev --port 3000",
    "dev:isolated-preview": "node scripts/start-isolated-preview.mjs",
    "dev:test-login": "PORT=3000 node scripts/setup-local-test-login.mjs && next dev -H 0.0.0.0 --port 3000",
    "dev:e2e": "node scripts/local-e2e.mjs dev",
    "design:audit": "node scripts/design-system-audit.mjs",
    "build": "next build",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks:pre-commit": "node scripts/git-hooks.mjs pre-commit",
    "hooks:pre-push": "node scripts/git-hooks.mjs pre-push",
    "lint": "eslint . --quiet",
    "migration:rehearse": "node scripts/rehearse-migrations.mjs",
    "perf:probe": "node scripts/perf-probe.mjs",
    "perf:prod": "node scripts/perf-prod.mjs",
    "perf:prod:auth": "node scripts/perf-prod.mjs --save-auth",
    "auth:local:copy-code": "node scripts/copy-local-login-code.mjs",
    "auth:local:rotate": "node scripts/setup-local-test-login.mjs --rotate-password",
    "auth:local:setup": "node scripts/setup-local-test-login.mjs",
    "auth:local:save": "node scripts/save-local-auth-state.mjs",
    "auth:e2e:save": "node scripts/local-e2e.mjs save-auth",
    "e2e:local:setup": "node scripts/local-e2e.mjs setup",
    "e2e:local:reset": "node scripts/local-e2e.mjs reset",
    "e2e:local:start": "node scripts/local-e2e.mjs start",
    "e2e:local:stop": "node scripts/local-e2e.mjs stop",
    "e2e:local:status": "node scripts/local-e2e.mjs status",
    "seed:archetypes": "node seed-archetypes.mjs",
    "schema:health": "node scripts/schema-health.mjs",
    "verify:deck-list-release": "node scripts/verify-deck-list-release.mjs",
    "verify:log-share-atomicity": "node scripts/rehearse-log-share-atomicity.mjs",
    "verify:battle-log-import-draft": "tsx scripts/verify-battle-log-import-draft.ts",
    "types:supabase": "supabase --agent=no gen types typescript --linked --schema public > types/supabase.ts",
    "sync:card-effect-catalog": "node sync-card-effect-catalog.mjs",
    "sync:pokemon-catalog": "node seed-pokemon.mjs",
    "start": "next start",
    "test": "tsx --test",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@next/env": "^16.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.0",
    "lucide-react": "^1.14.0",
    "next": "^16.3.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "agent-browser": "^0.26.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.25",
    "supabase": "2.115.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.25"
  }
}
