{
  "name": "poke-notes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "audit:pokemon-catalog": "tsx audit-pokemon-catalog.ts",
    "audit:pokemon-options": "node audit-pokemon-options.mjs",
    "backfill:deck-list-visual-sort": "tsx backfill-deck-list-visual-sort.ts",
    "backfill:log-links": "tsx backfill-log-links.ts",
    "clean": "rm -rf .next",
    "dev": "next dev",
    "dev:perf": "POKE_NOTES_DEBUG_PERF=1 next dev",
    "dev:reset": "rm -rf .next && next dev",
    "deploy:changed-sql": "node scripts/deploy-changed-sql.mjs",
    "build": "next build",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks:pre-commit": "node scripts/git-hooks.mjs pre-commit",
    "hooks:pre-push": "node scripts/git-hooks.mjs pre-push",
    "lint": "eslint . --quiet",
    "perf:probe": "node scripts/perf-probe.mjs",
    "perf:prod": "node scripts/perf-prod.mjs",
    "perf:prod:auth": "node scripts/perf-prod.mjs --save-auth",
    "seed:archetypes": "node seed-archetypes.mjs",
    "sync:card-effect-catalog": "node sync-card-effect-catalog.mjs",
    "sync:pokemon-catalog": "node seed-pokemon.mjs",
    "start": "next start",
    "test": "tsx --test",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.2.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "agent-browser": "^0.26.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.14"
  }
}
